{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/trace_hook.py\" --context || powershell -NoProfile -ExecutionPolicy Bypass -Command \"& \\\"$env:CLAUDE_PLUGIN_ROOT\\scripts\\trace-hook.ps1\\\" -Context\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/trace_hook.py\" || powershell -NoProfile -ExecutionPolicy Bypass -Command \"& \\\"$env:CLAUDE_PLUGIN_ROOT\\scripts\\trace-hook.ps1\\\"\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/scripts/trace_hook.py\" --upload || powershell -NoProfile -ExecutionPolicy Bypass -Command \"& \\\"$env:CLAUDE_PLUGIN_ROOT\\scripts\\trace-hook.ps1\\\" -Upload\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
